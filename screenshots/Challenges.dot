digraph Challenges {
    label="Пройденные трудности при развёртывании K8s";
    labelloc=t; fontsize=18; fontname="Arial";
    rankdir=TB; splines=ortho; nodesep=0.7; ranksep=0.5;
    node [shape=box, style=rounded, fontname="Arial", fontsize=10];
    
    start [label="Начало", shape=oval, fillcolor="#E8F0FE"];
    
    p1 [label="Flannel VXLAN\nне работает\nмежузловая связь", fillcolor="#FFCDD2"];
    s1 [label="Перешли на Calico\nIPIP-туннели\n(BGP-маршрутизация)", fillcolor="#C8E6C9"];
    
    p2 [label="CoreDNS NXDOMAIN\nnslookup не работает\n(Alpine-образ)", fillcolor="#FFCDD2"];
    s2 [label="Системный резолвер (glibc)\nработает через search-домены\ncurl успешно резолвит", fillcolor="#C8E6C9"];
    
    p3 [label="Velero + MinIO\nno route to host\n(разные узлы)", fillcolor="#FFCDD2"];
    s3 [label="Calico требует\nпересоздания подов\nпосле смены CNI\n(новые IP из правильной подсети)", fillcolor="#C8E6C9"];
    
    p4 [label="MinIO теряет данные\nпри пересоздании\n(emptyDir)", fillcolor="#FFCDD2"];
    s4 [label="Создали bucket\nчерез mkdir вручную\n(для production — PVC)", fillcolor="#C8E6C9"];
    
    p5 [label="Proxmox установка\nна ZFS — EFI\nне видит диск", fillcolor="#FFCDD2"];
    s5 [label="Очистили диск\nчерез sgdisk -Z\nпереустановили\nProxmox заново", fillcolor="#C8E6C9"];
    
    success [label="K8s + Calico + DNS +\nVelero + MinIO\nработают!", shape=oval, fillcolor="#A5D6A7", penwidth=2];
    
    start -> p1 -> s1 -> p2 -> s2 -> p3 -> s3 -> p4 -> s4 -> p5 -> s5 -> success;
}
